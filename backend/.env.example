NODE_ENV=production
PORT=3001

# Neon PostgreSQL (PRIMARY DATABASE — required)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname?sslmode=require

# Auth
JWT_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-64-byte-random-hex

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend HTTP API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=info@b2b.vivek-jha.me
EMAIL_TO=owner@example.com
EMAIL_REPLY_TO=Aprservices20@gmail.com
EMAIL_SANDBOX_MODE=false
EMAIL_DOMAIN_VERIFIED=true
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_SEND_RETRIES=2

# Email branding
COMPANY_NAME=Divyanshi Aviation Services Pvt Ltd
WEBSITE_URL=https://divyanshiaviation.com
COMPANY_PHONE=+91 9910997428
COMPANY_ADDRESS=Plot No. 22 & 23, Pillar No. 68, Near Nangli Metro Station, Ranaji Enclave, Najafgarh, New Delhi 110043
EMAIL_LOGO_URL=https://divyanshiaviation.com/assets/img/logo.png
EMAIL_BRAND_COLOR=#1557B0
SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/divyanshi-aviation-services-private-limited/
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=

# Contact form protection
CONTACT_DUPLICATE_WINDOW_MS=900000
CONTACT_MIN_FORM_COMPLETION_MS=1500

# CORS
ALLOWED_ORIGIN=https://divyanshiaviation.com,https://www.divyanshiaviation.com

# Admin setup
INITIAL_ADMIN_EMAIL=admin@divyanshiaviation.com
INITIAL_ADMIN_PASSWORD=divyanshi123
